{
  "name": "npl-enhanced-content",
  "version": "0.1.0",
  "description": "NPL-enhanced content — Unicode-block semantic markup rendered by Lit web components. Zero React.",
  "type": "module",
  "exports": {
    ".": "./dist/npl.js",
    "./preprocess": "./dist/preprocess.js",
    "./themes/*": "./themes/*"
  },
  "files": ["dist", "themes"],
  "scripts": {
    "build": "vite build",
    "test": "cypress run --e2e",
    "test:open": "cypress open --e2e",
    "serve": "vite preview --port 4173"
  },
  "dependencies": {
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "cypress": "^14.0.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0"
  }
}
